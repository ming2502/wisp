{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wisp",
  "identifier": "io.github.ming2502.wisp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "wisp",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "wisp contributors",
    "copyright": "Copyright © 2026 wisp contributors. Licensed under Apache-2.0.",
    "category": "DeveloperTool",
    "shortDescription": "轻量的 SSH/SFTP 客户端",
    "longDescription": "轻量的 SSH/SFTP 桌面客户端：终端、文件管理、断点续传和远程文件编辑。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NjlDOUQxQjMwRDQwNjAKUldSZ1FBMnowY2xwNWsxc2lhS1lBcDRRbGZkb1dGdFl4RGJIcGF4TUFTeDdUaC9XUGpyQ1M1TzYK",
      "endpoints": ["https://github.com/ming2502/wisp/releases/latest/download/latest.json"]
    }
  }
}
